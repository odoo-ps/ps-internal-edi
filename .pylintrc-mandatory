[MASTER]
load-plugins=pylint_odoo
score=n
extension-pkg-whitelist=
ignore-paths=tests

[MESSAGES CONTROL]
disable=all

enable=
    odoo-addons-relative-import,
    odoo-api-one-deprecated,
    odoo-api-multi-together,
    odoo-duplicate-xml-fields,
    odoo-duplicate-xml-record-id,
    odoo-license-allowed,
    odoo-manifest-author-string,
    odoo-manifest-required-author,
    odoo-manifest-required-key,
    odoo-manifest-version-format,
    odoo-manifest-deprecated-key,
    odoo-missing-readme,
    odoo-missing-license,
    odoo-missing-icon,
    odoo-translation-field,
    odoo-translation-required,
    odoo-view-duplicate-id,
    odoo-view-syntax-error,
    odoo-rst-syntax-error,
    odoo-wrong-tabs-instead-of-spaces,
    odoo-use-vim-comment,
    odoo-print-used,
    odoo-sql-injection,
    odoo-eval-referenced,
    odoo-eval-used,
    odoo-database-exists,
    odoo-unreachable,
    odoo-duplicate-id-csv,
    odoo-dangerous-view-replace-wo-priority,
    odoo-dangerous-default-value,
    odoo-development-status-allowed,
    odoo-redundant-modulename-xml,
    odoo-xml-syntax-error,
    odoo-duplicate-key,
    odoo-attribute-deprecated,
    odoo-pointless-statement,
    odoo-pointless-string-statement

[REPORTS]
msg-template={path}:{line}: [{msg_id}({symbol}), {obj}] {msg}
output-format=colorized
reports=no
