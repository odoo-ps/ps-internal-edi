<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- make edi.table.record company-restricted records -->
    <record id="edi_table_record_company_rule" model="ir.rule">
        <field name="name">Restricted EDI 2-steps Queue Record: multi-company</field>
        <field name="model_id" ref="model_edi_table_record"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
    </record>
</odoo>
