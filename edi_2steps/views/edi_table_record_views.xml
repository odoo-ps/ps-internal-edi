<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edi_table_record_tree_view" model="ir.ui.view">
        <field name="name">edi.table.record.tree</field>
        <field name="model">edi.table.record</field>
        <field name="arch" type="xml">
            <list
                string="EDI 2-steps Queue Records"
                edit="0"
                create="0"
                delete="0"
                decoration-success="state=='done'"
                decoration-info="state=='new'"
                decoration-warning="state=='warning'"
                decoration-muted="state=='cancelled'"
                decoration-danger="state=='fail'"
            >
                <field name="create_date" optional="hide"/>
                <field name="integration_id"/>
                <field name="identifier" optional="hide"/>
                <field name="filename" optional="show"/>
                <field name="name_short" optional="hide"/>
                <field name="content" optional="hide"/>
                <field name="state" optional="show"/>
                <field name="updated_by_sync_count" string="Updates" optional="show"/>
                <field name="processed_by_sync_count" string="Processing Attempts" optional="show"/>
                <button
                    name="open_updated_by_syncs"
                    string="Update Syncs"
                    type="object"
                    invisible="updated_by_sync_count == 0"
                />
                <button
                    name="open_processed_by_syncs"
                    string="Process Syncs"
                    type="object"
                    invisible="processed_by_sync_count == 0"
                />
                <field name="can_be_processed" optional="hide"/>
                <field name="last_process_date" optional="hide"/>
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="edi_table_record_form_view" model="ir.ui.view">
        <field name="name">edi.table.record.form</field>
        <field name="model">edi.table.record</field>
        <field name="arch" type="xml">
            <form string="EDI 2-steps Queue" edit="0" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="open_synchronizations"
                            icon="fa-cloud-upload"
                            class="oe_stat_button"
                            string="Synchronizations"
                        />
                    </div>
                    <separator string="Basic Information"/>
                    <group>
                        <group>
                            <field name="integration_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Update">
                            <field name="identifier"/>
                            <field name="filename"/>
                            <field name="updated_by_sync_count" string="Updates"/>
                            <button
                                name="open_updated_by_syncs"
                                string="Update Syncs"
                                type="object"
                                optional="show"
                                invisible="updated_by_sync_count == 0"
                            />
                        </group>
                        <group string="Process">
                            <field name="state"/>
                            <field name="processed_by_sync_count" string="Process Attempts"/>
                            <field name="last_process_date"/>
                            <button
                                name="open_processed_by_syncs"
                                string="Process Syncs"
                                type="object"
                                optional="show"
                                invisible="processed_by_sync_count == 0"
                            />
                        </group>
                    </group>
                    <notebook invisible="not content and not error_ids">
                        <page
                            name="content"
                            string="Content"
                            invisible="not content"
                        >
                            <field name="content"/>
                        </page>
                        <page string="Failures" invisible="not error_ids">
                            <field
                                name="error_ids"
                                context="{
                                    'list_view_ref': 'edi_base.synchronization_error_embedded_tree_view',
                                    'sync_id': id
                                }"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="edi_table_record_search_view" model="ir.ui.view">
        <field name="name">edi.table.record.search.view</field>
        <field name="model">edi.table.record</field>
        <field name="arch" type="xml">
            <search string="EDI 2-steps Queue">
                <field name="integration_id"/>
                <field name="identifier"/>
                <field name="filename"/>
                <field name="content"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="success" string="Success" domain="[('state', '=', 'done')]"/>
                <filter name="warning" string="Warning" domain="[('state', '=', 'warning')]"/>
                <filter name="fail" string="Fail" domain="[('state', '=', 'fail')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="can_be_processed" string="Can be Processed" domain="[('can_be_processed', '=', True)]"/>
                <group>
                    <filter name="group_by_integration" string="Integration" context="{'group_by': 'integration_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_identifier" string="Identifier" context="{'group_by': 'identifier'}"/>
                    <filter name="group_by_filename" string="Filename" context="{'group_by': 'filename'}"/>
                    <filter
                        name="group_by_create_date"
                        string="Create Date"
                        context="{'group_by': 'create_date:month'}"
                    />
                    <filter
                        name="group_by_last_process_date"
                        string="Last Process Date"
                        context="{'group_by': 'last_process_date:day'}"
                    />
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="edi_table_record_act_window" model="ir.actions.act_window">
        <field name="name">EDI 2-steps Queue Records</field>
        <field name="res_model">edi.table.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="edi_2steps.edi_table_record_search_view"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent">
                Here you will find the EDI 2-steps Queue Records.
            </p>
        </field>
    </record>
    <menuitem
        id="edi_table_menu"
        parent="edi_base.root_menu"
        name="2-steps Queue"
        sequence="20"
        action="edi_table_record_act_window"
    />
</odoo>
