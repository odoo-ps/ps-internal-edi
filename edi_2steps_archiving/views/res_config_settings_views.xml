<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_edi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.edi.2steps.archiving</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="edi_base.res_config_settings_view_form_edi"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='edi_base']" position="inside">
                <block title="EDI 2-steps Archiving and Deleting" name="edi_2steps_settings_block">
                    <setting string="Duration" help="Delay before archiving and deleting the EDI 2-steps Queue Records (0 means never)">
                        <div class="mt16" id="edi_archiving_duration_div">
                            <div class="mt16" id="edi_archiving_duration">
                                <label string="Archive after" for="edi_table_record_archive_duration" class=" col-lg-3"/>
                                <field name="edi_table_record_archive_duration" class="text-center" style="width: 5rem"/>
                                <div class="d-inline-block">days</div>
                            </div>
                            <div class="mt16" id="edi_delete_duration">
                                <label string="Delete after" for="edi_table_record_delete_duration" class=" col-lg-3"/>
                                <field name="edi_table_record_delete_duration" class="text-center" style="width: 5rem"/>
                                <div class="d-inline-block">days</div>
                            </div>
                        </div>
                    </setting>
                    <setting string="States" help="Archive table records with those states">
                        <div class="mt16 content-group" id="edi_table_record_archive_state_error">
                            <field name="edi_table_record_archive_state_error"/>
                            <label for="edi_table_record_archive_state_error" class="o_light_label" string="Error"/>
                        </div>
                        <div class="mt16 content-group" id="edi_table_record_archive_state_success">
                            <field name="edi_table_record_archive_state_success"/>
                            <label for="edi_table_record_archive_state_success" class="o_light_label" string="Success"/>
                        </div>
                        <div class="mt16 content-group" id="edi_table_record_archive_state_new">
                            <field name="edi_table_record_archive_state_new"/>
                            <label for="edi_table_record_archive_state_new" class="o_light_label" string="New"/>
                        </div>
                        <div class="mt16 content-group" id="edi_table_record_archive_state_cancel">
                            <field name="edi_table_record_archive_state_cancel"/>
                            <label for="edi_table_record_archive_state_cancel" class="o_light_label" string="Cancel"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
