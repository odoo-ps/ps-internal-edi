<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_edi_archiving" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.edi.archiving</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="edi_base.res_config_settings_view_form_edi"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='edi_base']" position="inside">
                <block title="Synchronizations Archiving and Deleting" name="edi_archiving_settings_block">
                    <setting
                        string="Duration"
                        help="Delay before archiving and deleting the synchronizations (0 means never)"
                    >
                        <div class="mt16" id="edi_archiving_duration_div">
                            <div class="mt16" id="edi_archiving_duration">
                                <label string="Archive after" for="edi_archive_duration" class=" col-lg-3"/>
                                <field name="edi_archive_duration" class="text-center" style="width: 5rem"/>
                                <div class="d-inline-block">days</div>
                            </div>
                            <div class="mt16" id="edi_delete_duration">
                                <label string="Delete after" for="edi_delete_duration" class=" col-lg-3"/>
                                <field name="edi_delete_duration" class="text-center" style="width: 5rem"/>
                                <div class="d-inline-block">days</div>
                            </div>
                        </div>
                    </setting>
                    <setting string="States" help="Archive synchronizations with those states">
                        <div class="mt16 content-group" id="edi_archive_state_fail">
                            <field name="edi_archive_state_fail"/>
                            <label for="edi_archive_state_fail" class="o_light_label" string="Fail"/>
                        </div>
                        <div class="mt16 content-group" id="edi_archive_state_done">
                            <field name="edi_archive_state_done"/>
                            <label for="edi_archive_state_done" class="o_light_label" string="Done"/>
                        </div>
                        <div class="mt16 content-group" id="edi_archive_state_new">
                            <field name="edi_archive_state_new"/>
                            <label for="edi_archive_state_new" class="o_light_label" string="New"/>
                        </div>
                        <div class="mt16 content-group" id="edi_archive_state_cancelled">
                            <field name="edi_archive_state_cancelled"/>
                            <label for="edi_archive_state_cancelled" class="o_light_label" string="Cancelled"/>
                        </div>
                    </setting>
                    <setting
                        string="Clear error details when archiving"
                        help="Empty the description of the errors attached to an archived synchronization. The errors themselves are kept, with their activity and date, but their stored text is released."
                    >
                        <field name="edi_archive_clear_error_description"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
