<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="connection_form_view" model="ir.ui.view">
        <field name="name">edi.connection.form</field>
        <field name="model">edi.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="test" string="Test"/>
                    <button type="object" name="reset_config" string="Reset Configuration"/>
                    <button
                        type="object"
                        name="reset_cached_token"
                        string="Reset Token"
                        invisible="not cached_token"
                        groups="base.group_system"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h3>
                            <label for="name" string="Name" class="oe_edit_only"/>
                            <field name="name"/>
                        </h3>
                    </div>
                    <group name="configuration">
                        <group name="basic" string="Basic Information">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="type" readonly="1"/>
                            <field name="configuration" groups="base.group_system" invisible="type == 'api'"/>
                            <field name="url" invisible="type != 'api'"/>
                            <field name="auth_method" invisible="type != 'api'" readonly="1"/>
                            <field
                                name="credential_type"
                                invisible="type != 'api' or not auth_method or auth_method == 'public'"
                                readonly="1"
                            />
                        </group>
                        <group
                            name="authentication"
                            string="Authentication"
                            invisible="not auth_method or auth_method == 'public'"
                        >
                            <field name="token_path" invisible="auth_method != 'http_oauth2'"/>
                            <field name="key" invisible="credential_type != 'single_key'"/>
                            <field name="key_header_name" invisible="auth_method != 'http_bearer'"/>
                            <field name="key_format" invisible="auth_method != 'http_bearer'"/>
                            <field name="username" invisible="credential_type not in ('user_pass', 'user_key_secret')"/>
                            <field
                                name="password"
                                invisible="credential_type not in ('user_pass', 'user_key_secret')"
                                password="True"
                            />
                            <field
                                name="client_id"
                                invisible="credential_type not in ('key_secret', 'user_key_secret')"
                            />
                            <field
                                name="client_secret"
                                invisible="credential_type not in ('key_secret', 'user_key_secret')"
                                password="True"
                            />
                            <field name="scope" invisible="credential_type not in ('key_secret', 'user_key_secret')"/>

                            <separator string="Cached OAuth2 token" invisible="auth_method != 'http_oauth2'"/>
                            <field
                                name="cached_token"
                                string="Token"
                                invisible="auth_method != 'http_oauth2'"
                                groups="base.group_system"
                            />
                            <field
                                name="cached_token_expires"
                                string="Expired on"
                                invisible="auth_method != 'http_oauth2'"
                            />
                        </group>
                        <group name="details"> </group>
                    </group>
                    <notebook>
                        <page string="Integrations">
                            <field name="integration_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="connection_tree_view" model="ir.ui.view">
        <field name="name">edi.connection.tree</field>
        <field name="model">edi.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="connection_search_view" model="ir.ui.view">
        <field name="name">edi.connection.search.view</field>
        <field name="model">edi.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <group>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'type'}"/>
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="connections_act_window" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">edi.connection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="edi_base.connection_search_view"/>
    </record>
    <menuitem
        id="connections_menu"
        parent="root_menu"
        name="Connections"
        sequence="10"
        action="connections_act_window"
    />
</odoo>
