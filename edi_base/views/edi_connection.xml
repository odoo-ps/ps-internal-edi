<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="connection_form_view" model="ir.ui.view">
        <field name="name">edi.connection.form</field>
        <field name="model">edi.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="test" string="Test"/>
                    <button type="object" name="reset_config" string="Reset Configuration"/>
                    <button
                        type="object"
                        name="api_reset_token"
                        string="Reset Token"
                        invisible="not api_token"
                        groups="base.group_system"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h3>
                            <label for="name" string="Name" class="oe_edit_only"/>
                            <field name="name"/>
                        </h3>
                    </div>
                    <group name="configuration">
                        <group name="basic" string="Basic Information">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="type"/>
                            <field name="configuration" groups="base.group_system" invisible="type == 'api'"/>
                            <field name="url" invisible="type != 'api'"/>
                            <field name="api_auth_type" invisible="type != 'api'"/>
                       </group>
                        <group
                            name="authentication"
                            string="Authentication"
                            invisible="type != 'api' or not api_auth_type or api_auth_type == 'public'"
                        >
                            <field name="key" invisible="api_auth_type != 'api_key'"/>
                            <field name="token_path" invisible="api_auth_type != 'oauth2'"/>
                            <field name="grant_type" invisible="api_auth_type != 'oauth2'"/>
                            <field
                                name="username"
                                invisible="not(api_auth_type == 'basic' or (api_auth_type == 'oauth2' and grant_type == 'password'))"
                            />
                            <field
                                name="password"
                                invisible="not(api_auth_type == 'basic' or (api_auth_type == 'oauth2' and grant_type == 'password'))"
                                password="True"
                            />
                            <field name="client_id" invisible="api_auth_type != 'oauth2'"/>
                            <field name="client_secret" invisible="api_auth_type != 'oauth2'" password="True"/>
                            <field name="scope" invisible="api_auth_type != 'oauth2'"/>
                            <field name="api_token" invisible="api_auth_type != 'oauth2'" groups="base.group_system"/>
                            <field name="api_token_expires" invisible="api_auth_type != 'oauth2'"/>
                        </group>
                        <group name="details"> </group>
                    </group>
                    <notebook>
                        <page string="Integrations">
                            <field name="integration_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="connection_tree_view" model="ir.ui.view">
        <field name="name">edi.connection.tree</field>
        <field name="model">edi.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="connection_search_view" model="ir.ui.view">
        <field name="name">edi.connection.search.view</field>
        <field name="model">edi.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <group>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'type'}"/>
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="connections_act_window" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">edi.connection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="edi_base.connection_search_view"/>
    </record>
    <menuitem
        id="connections_menu"
        parent="root_menu"
        name="Connections"
        sequence="10"
        action="connections_act_window"
    />
</odoo>
