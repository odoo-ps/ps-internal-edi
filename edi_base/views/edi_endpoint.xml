<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="endpoint_form_view" model="ir.ui.view">
        <field name="name">edi.endpoint.form</field>
        <field name="model">edi.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group name="header">
                        <group name="connection">
                            <field name="connection_id"/>
                            <field name="role" readonly="auth_type != 'oauth2'"/>
                            <field name="method" invisible="role == 'token'"/>
                            <field name="url"/>
                        </group>
                        <group name="credentials">
                            <field name="api_key" invisible="auth_type != 'api_key'" password="True"/>
                            <field name="grant_type" invisible="role != 'token'"/>
                            <field
                                name="username"
                                invisible="not(auth_type == 'basic' or (auth_type == 'oauth2' and grant_type == 'password'))"
                            />
                            <field
                                name="password"
                                invisible="not(auth_type == 'basic' or (auth_type == 'oauth2' and grant_type == 'password'))"
                                password="True"
                            />
                            <field name="client_id" invisible="role != 'token'"/>
                            <field name="client_secret" invisible="role != 'token'" password="True"/>
                            <field name="scope" invisible="role != 'token'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Integrations" invisible="role != 'resource'">
                            <group>
                                <field name="integration_ids"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="endpoint_tree_view" model="ir.ui.view">
        <field name="name">edi.endpoint.tree</field>
        <field name="model">edi.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="connection_id"/>
                <field name="method" string="Method"/>
                <field name="url"/>
            </list>
        </field>
    </record>

    <record id="endpoints_act_window" model="ir.actions.act_window">
        <field name="name">Endpoints</field>
        <field name="res_model">edi.endpoint</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="endpoints_menu"
        parent="configuration_menu"
        name="Endpoints"
        sequence="10"
        action="endpoints_act_window"
    />
</odoo>
