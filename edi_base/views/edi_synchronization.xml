<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="synchronization_error_tree_view" model="ir.ui.view">
        <field name="name">edi.synchronization.error.tree</field>
        <field name="model">edi.synchronization.error</field>
        <field name="arch" type="xml">
            <list string="Synchronization errors" edit="0" create="0" delete="0">
                <field name="synchronization_id"/>
                <field name="create_date"/>
                <field name="write_date"/>
                <field name="activity"/>
                <field name="description_short"/>
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="synchronization_error_form_view" model="ir.ui.view">
        <field name="name">edi.synchronization.error.form</field>
        <field name="model">edi.synchronization.error</field>
        <field name="arch" type="xml">
            <form string="Synchronization error" edit="0" create="0" delete="0">
                <sheet>
                    <h1>
                        <field name="synchronization_id"/>
                    </h1>
                    <group>
                        <group>
                            <field name="activity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="synchronization_error_embedded_tree_view" model="ir.ui.view">
        <field name="name">edi.synchronization.error.embedded.tree</field>
        <field name="model">edi.synchronization.error</field>
        <field name="inherit_id" ref="edi_base.synchronization_error_tree_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="synchronization_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>
    <record id="synchronization_form_view" model="ir.ui.view">
        <field name="name">edi.synchronization.form</field>
        <field name="model">edi.synchronization</field>
        <field name="arch" type="xml">
            <form string="Synchronization" edit="0" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">

                    </div>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <div>
                        <field name="filename"/>
                    </div>
                    <separator string="Basic Information"/>
                    <group>
                        <group name="left_group">
                            <field name="create_date"/>
                            <field name="write_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="right_group">
                            <field name="synchronization_date"/>
                        </group>
                    </group>
                    <notebook invisible="not error_ids and not content">
                        <page string="Content" invisible="not content">
                            <group>
                                <field name="content_type"/>
                                <field name="content" invisible="content_type == 'pdf'"/>
                            </group>
                        </page>
                        <page string="Failures" invisible="not error_ids">
                            <field
                                name="error_ids"
                                context="{
                                'list_view_ref': 'edi_base.synchronization_error_embedded_tree_view',
                                'sync_id': id
                            }"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="synchronization_list_view" model="ir.ui.view">
        <field name="name">edi.synchronization.tree</field>
        <field name="model">edi.synchronization</field>
        <field name="arch" type="xml">
            <list
                string="Synchronizations"
                edit="0"
                create="0"
                delete="0"
                decoration-success="state=='done'"
                decoration-info="state=='new'"
                decoration-muted="state=='cancel'"
                decoration-danger="state=='fail'"
            >
                <field name="name"/>
                <field name="content_type"/>
                <field name="create_date"/>
                <field name="synchronization_date"/>
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    options="{'no_create': True}"
                    optional="show"
                />
            </list>
        </field>
    </record>
    <record id="synchronization_kanban_view" model="ir.ui.view">
        <field name="name">edi.syncrhonization.kanban.view</field>
        <field name="model">edi.synchronization</field>
        <field name="arch" type="xml">
            <kanban string="Synchronizations" create="0" delete="0" highlight_color="color">
                <field name="name"/>
                <field name="name_short"/>
                <field name="color"/>
                <field name="state"/>
                <field name="filename_short"/>
                <field name="synchronization_date"/>
                <field name="company_id"/>
                <templates>
                     <t t-name="menu" groups="base.group_user">
                        <div class="container">
                            <div class="row">
                                <div class="col-12">
                                    <a role="menuitem" type="object" name="open_integration" class="dropdown-item">
                                        Open Integration
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <main class="o_integration_kanban_main">
                            <div>
                                <field class="d-block fw-bold fs-5" name="name_short"/>
                            </div>
                            <hr class="mt4 mb4"/>
                            <div class="row">
                                <div class="col">
                                    <div t-if="record.filename_short.raw_value">
                                        <i>
                                            <field name="filename_short"/>
                                        </i>
                                    </div>
                                   <div id="status">
                                        <strong>Status :</strong>
                                        <field name="state"/>
                                   </div>
                                   <div id="create_date" title="Creation Date">
                                       <i class="fa fa-calendar-plus-o me-2" aria-label="Creation Date"/>
                                       <field name="create_date"/>
                                   </div>
                                   <div id="synchronization_date" title="Synchronization Date">
                                        <i class="fa fa-calendar-check-o me-2" aria-label="Synchronization Date"/>
                                        <field name="synchronization_date"/>
                                   </div>
                                    <div id="content_type" title="Content Type">
                                        <i class="fa fa-file-o me-2" aria-label="Content Type"/>
                                        <field name="content_type"/>
                                   </div>
                                    <div id="company_id" t-if="record.company_id.value" title="Company">
                                        <strong>Company :</strong>
                                        <t t-out="record.company_id.value"/>
                                   </div>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="synchronization_search_view" model="ir.ui.view">
        <field name="name">edi.syncrhonization.search.view</field>
        <field name="model">edi.synchronization</field>
        <field name="arch" type="xml">
            <search string="Synchronization File">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('filename', 'ilike', self)]"/>
                <field name="integration_id"/>
                <field name="content"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter
                    name="in_synchronizations"
                    string="Incoming Synchronizations"
                    domain="[('synchronization_flow', '=', 'in')]"
                />
                <filter
                    name="out_synchronizations"
                    string="Outgoing Synchronizations"
                    domain="[('synchronization_flow', '=', 'out')]"
                />
                <separator/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="fail" string="Failed" domain="[('state', '=', 'fail')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <group string="Group By">
                    <filter name="group_by_integration" string="Integration" context="{'group_by': 'integration_id'}"/>
                    <filter name="group_by_type" string="Flow Type" context="{'group_by': 'synchronization_flow'}"/>
                    <filter name="group_by_content_type" string="Content Type" context="{'group_by': 'content_type'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter
                        name="group_by_synchronization_date"
                        string="Synchronization Date"
                        context="{'group_by': 'synchronization_date:month'}"
                    />
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="synchronizations_act_window" model="ir.actions.act_window">
        <field name="name">Synchronizations</field>
        <field name="res_model">edi.synchronization</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="edi_base.synchronization_search_view"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent">
                Here you will find the files created to be synchronized with the remote servers configured on your
                integrations.
            </p>
        </field>
    </record>
    <menuitem
        id="synchronizations_menu"
        parent="root_menu"
        name="Synchronizations"
        sequence="10"
        action="synchronizations_act_window"
    />
</odoo>
