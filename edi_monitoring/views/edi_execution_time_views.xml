<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="integration_form_view_execution_time" model="ir.ui.view">
        <field name="name">edi.integration.form.execution_time</field>
        <field name="model">edi.integration</field>
        <field name="inherit_id" ref="edi_base.integration_form_view"/>
        <field name="arch" type="xml">
            <field name="connection_id" position="after">
                <field name="reasonable_execution_time" widget="float_time"/>
            </field>
        </field>
    </record>
    <record id="synchronization_list_view_execution_time" model="ir.ui.view">
        <field name="name">edi.synchronization.tree.execution_time</field>
        <field name="model">edi.synchronization</field>
        <field name="inherit_id" ref="edi_base.synchronization_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree">
                <field name="reasonable_execution_time" invisible="1"/>
                <field
                    name="execution_time"
                    widget="float_time"
                    decoration-warning="execution_time &gt;= reasonable_execution_time"
                />
            </xpath>
        </field>
    </record>
    <record id="synchronization_form_view_execution_time" model="ir.ui.view">
        <field name="name">edi.integration.form.execution_time</field>
        <field name="model">edi.synchronization</field>
        <field name="inherit_id" ref="edi_base.synchronization_form_view"/>
        <field name="arch" type="xml">
            <field name="synchronization_date" position="after">
                <field name="reasonable_execution_time" invisible="1"/>
                <field
                    name="execution_time"
                    widget="float_time"
                    decoration-warning="execution_time &gt;= reasonable_execution_time"
                />
            </field>
        </field>
    </record>
</odoo>
