<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="synchronization_form_view_inherit_monitoring" model="ir.ui.view">
        <field name="name">edi.synchronization.form.inherit.monitoring</field>
        <field name="model">edi.synchronization</field>
        <field name="inherit_id" ref="edi_base.synchronization_form_view"/>
        <field name="arch" type="xml">
            <field name="content_type" position="after">
                <field name="file_size" attrs="{'invisible': [('file_size', '=', 0)]}"/>
            </field>
        </field>
    </record>

    <record id="synchronization_tree_view_inherit_monitoring" model="ir.ui.view">
        <field name="name">edi.synchronization.tree.inherit.monitoring</field>
        <field name="model">edi.synchronization</field>
        <field name="inherit_id" ref="edi_base.synchronization_list_view"/>
        <field name="arch" type="xml">
            <field name="content_type" position="after">
                <field name="file_size" attrs="{'invisible': [('file_size', '=', 0)]}"/>
            </field>
        </field>
    </record>
</odoo>
