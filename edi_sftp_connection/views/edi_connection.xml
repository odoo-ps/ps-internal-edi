<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="connection_form_view_sftp" model="ir.ui.view">
        <field name="name">edi.connection.form.sftp</field>
        <field name="model">edi.connection</field>
        <field name="inherit_id" ref="edi_ftp_connection.connection_form_view_ftp"/>
        <field name="arch" type="xml">
            <field name="ftp_in_done_let" position="attributes">
                <attribute name="invisible">type not in ['ftp', 'sftp']</attribute>
            </field>
            <field name="ftp_load_content" position="attributes">
                <attribute name="invisible">type not in ['ftp', 'sftp']</attribute>
            </field>
            <field name="ftp_limit_in_files" position="attributes">
                <attribute name="invisible">type not in ['ftp', 'sftp']</attribute>
            </field>
        </field>
    </record>
</odoo>
