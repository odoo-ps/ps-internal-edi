<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="connection_form_view" model="ir.ui.view">
        <field name="model">edi.connection</field>
        <field name="inherit_id" ref="edi_base.connection_form_view"/>
        <field name="arch" type="xml">
            <field name="timeout" position="after">
                <field
                    name="sftp_host_key"
                    invisible="transport != 'sftp'"
                    placeholder="Saved on the first connection, e.g. ssh-ed25519 AAAA..."
                />
            </field>
        </field>
    </record>
</odoo>
