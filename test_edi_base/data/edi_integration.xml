<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Creation of new Listing-->
        <record id="folder_connection" model="edi.connection">
            <field name="name">Connection to folder</field>
            <field name="type">folder</field>
            <field name="configuration"><![CDATA[
{
    "in_folder": "/tmp/edi/in",
    "in_folder_done": "/tmp/edi/in/done",
    "in_folder_error": "/tmp/edi/in/error",
    "out_folder": "/tmp/edi/out"
}
            ]]></field>
        </record>

        <record id="export_partner_filter" model="ir.filters">
            <field name="name">Export Partner</field>
            <field name="model_id">res.partner</field>
            <field name="domain">[["name","ilike","EDI TEST"]]</field>
        </record>

        <record id="export_partner_filter_integration" model="edi.integration">
            <field name="name">Export Partner with filter</field>
            <field name="type">partner_folder_out</field>
            <field name="integration_flow">out</field>
            <field name="synchronization_creation">multi</field>
            <field name="synchronization_content_type">csv</field>
            <field name="connection_id" ref="folder_connection" />
            <field name="record_filter_id" ref="export_partner_filter" />
            <field name="active" eval="False" />
            <field name="parameter"><![CDATA[
{
  "fields" : ["id", "name"]
}
            ]]></field>
        </record>

        <record id="export_partner_filter_integration_one" model="edi.integration">
            <field name="name">Export Partner with filter</field>
            <field name="type">partner_folder_out</field>
            <field name="integration_flow">out</field>
            <field name="synchronization_creation">one</field>
            <field name="synchronization_content_type">csv</field>
            <field name="connection_id" ref="folder_connection" />
            <field name="record_filter_id" ref="export_partner_filter" />
            <field name="active" eval="False" />
            <field name="parameter"><![CDATA[
{
  "fields" : ["id", "name"]
}
            ]]></field>
        </record>

        <record id="export_partner_no_filter_integration" model="edi.integration">
            <field name="name">Export Partner without filter</field>
            <field name="type">partner_folder_out</field>
            <field name="integration_flow">out</field>
            <field name="synchronization_creation">multi</field>
            <field name="synchronization_content_type">csv</field>
            <field name="connection_id" ref="folder_connection" />
            <field name="active" eval="False" />
            <field name="parameter"><![CDATA[
{
  "filter" : [["name","ilike","EDI TEST"]],
  "fields" : ["id", "name"]
}
            ]]></field>
        </record>

        <record id="import_partner_integration" model="edi.integration">
            <field name="name">Import Partner</field>
            <field name="type">partner_folder_in</field>
            <field name="integration_flow">in</field>
            <field name="synchronization_content_type">csv</field>
            <field name="connection_id" ref="folder_connection" />
            <field name="active" eval="False" />
        </record>
    </data>
</odoo>